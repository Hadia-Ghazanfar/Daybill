{
  "buildCommand": "cd web && npm install && npm run build",
  "framework": null,
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/auth/register", "destination": "/api/auth?action=register" },
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/admin-login", "destination": "/api/auth?action=admin-login" },
    { "source": "/api/auth/me", "destination": "/api/auth?action=me" },
    { "source": "/api/admin/accounts", "destination": "/api/admin?action=accounts" },
    { "source": "/api/purchases/:id/deliver", "destination": "/api/purchases?id=:id&action=deliver" },
    { "source": "/api/customers/:id", "destination": "/api/customers?id=:id" },
    { "source": "/api/suppliers/:id", "destination": "/api/suppliers?id=:id" },
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" },
    { "source": "/api/invoices/:id", "destination": "/api/invoices?id=:id" },
    { "source": "/api/purchases/:id", "destination": "/api/purchases?id=:id" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
