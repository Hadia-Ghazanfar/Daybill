{
  "buildCommand": "cd web && npm install && npm run build",
  "framework": null,
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/auth/register", "destination": "/api/auth-register" },
    { "source": "/api/auth/login", "destination": "/api/auth-login" },
    { "source": "/api/auth/admin-login", "destination": "/api/auth-admin-login" },
    { "source": "/api/auth/register", "destination": "/api/auth-register" },
    { "source": "/api/auth/login", "destination": "/api/auth-login" },
    { "source": "/api/auth/admin-login", "destination": "/api/auth-admin-login" },
    { "source": "/api/auth/me", "destination": "/api/auth-me" },
    { "source": "/api/admin/accounts", "destination": "/api/admin-accounts" },
    { "source": "/api/purchases/:id/deliver", "destination": "/api/purchases-deliver?id=:id" },
    { "source": "/api/customers/:id", "destination": "/api/customers-id?id=:id" },
    { "source": "/api/suppliers/:id", "destination": "/api/suppliers-id?id=:id" },
    { "source": "/api/products/:id", "destination": "/api/products-id?id=:id" },
    { "source": "/api/invoices/:id", "destination": "/api/invoices-id?id=:id" },
    { "source": "/api/purchases/:id", "destination": "/api/purchases-id?id=:id" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
